{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBD助手",
  "version": "0.1.0",
  "identifier": "org.dbd-cn.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DBD 助手 - 黎明杀机中文工具",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../data/dbd_cn.db": "data/dbd_cn.db",
      "../../data/icons/": "data/icons/"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}